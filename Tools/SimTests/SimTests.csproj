<Project Sdk="Microsoft.NET.Sdk">
  <!-- Testet die reine Spiellogik (Assets/Logistikum/Sim) ohne Unity, mit derselben C#-Version wie Unity 6. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>CS0649;CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Assets/Logistikum/Sim/**/*.cs" />
    <Compile Include="../../Assets/Logistikum/Tests/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>
</Project>
